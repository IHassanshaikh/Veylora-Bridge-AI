# TrustBridge AI Environment Configuration

# Server
PORT=8000
DATABASE_URL=sqlite:///./trustbridge.db

# PayPal Sandbox Configuration
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id-here
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret-here
PAYPAL_WEBHOOK_ID=

# Google Gemini AI Configuration
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage & Security
EVIDENCE_DIR=./evidence_vault
SECRET_KEY=trustbridge-hackathon-2026-production-ready-key

